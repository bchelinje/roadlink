# Railway Environment Variables Template
# Copy these variables to your Railway project settings

# Database Connection (Railway will provide DATABASE_URL automatically)
# You'll need to construct the connection string from Railway's PostgreSQL variables
ConnectionStrings__DefaultConnection=${{POSTGRES_URL}}

# OR manually construct it:
# ConnectionStrings__DefaultConnection=Host=${{PGHOST}};Port=${{PGPORT}};Database=${{PGDATABASE}};Username=${{PGUSER}};Password=${{PGPASSWORD}};SSL Mode=Require;Trust Server Certificate=true

# ASP.NET Core Settings
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:8080

# Authentication Settings
Jwt__Secret=<generate-a-secure-random-string-at-least-32-characters>
Jwt__Issuer=https://your-railway-app.up.railway.app
Jwt__Audience=https://your-railway-app.up.railway.app
Jwt__ExpiryMinutes=60

# Google Maps API (for distance calculations)
GoogleMaps__ApiKey=<your-google-maps-api-key>

# Stripe Payment Settings (if using)
Stripe__SecretKey=<your-stripe-secret-key>
Stripe__PublishableKey=<your-stripe-publishable-key>

# CORS Settings (your frontend URL)
AllowedOrigins__0=https://your-vercel-app.vercel.app

# Email Settings (optional - configure if using email features)
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__SmtpUsername=<your-email>
Email__SmtpPassword=<your-app-password>
Email__FromAddress=<your-email>
Email__FromName=BeC OpenID Connect
